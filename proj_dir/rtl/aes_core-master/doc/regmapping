0x00 : CTRL_STATUS

STATUS [31:16]
    bit 16 = DONE
    bit 17 = KDONE
    bit 31:18 = RESERVED

CONTROL [15:0]
    bit 0  = LD
    bit 1  = KLD
    bit 2  = RST
    bit 15:3 = RESERVED





