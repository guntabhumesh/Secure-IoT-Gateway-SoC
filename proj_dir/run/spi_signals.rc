// =============================================================================
// spi_signals.rc  -  Verdi waveform signal configuration for SPI Master
//
// Project  : Secure IoT Gateway SoC
// Block    : SPI Master  (SPI_Master_With_Single_CS + SPI_Master)
// Testbench: SPI_Master_With_Single_CS_TB
//
// Load in Verdi:
//   verdi -f run_spi.f -ssf dump_spi.fsdb -rc spi_signals.rc -nologo &
//
// Or from the Verdi command window:
//   novas::restore_session -file spi_signals.rc
//
// Signal Groups and what to look for:
// ─────────────────────────────────────────────────────────────────────────────
//  [Clock & Reset]
//    r_Clk      : 25 MHz system clock (period = 4 ns)
//    r_Rst_L    : Active-low reset; should go 0 -> 1 after 10 clocks
//
//  [TX Control - host driving the master]
//    r_Master_TX_Byte : 8-bit data the TB wants to transmit  (e.g. 0xC1, 0xC2)
//    r_Master_TX_DV   : Data-Valid pulse - 1 clock wide, triggers a transfer
//    r_Master_TX_Count: Number of bytes per CS-low window (2 in TB)
//    w_Master_TX_Ready: Goes HIGH when master is idle / ready for next byte
//
//  [SPI Bus - physical 4-wire interface]
//    w_SPI_Clk   : SPI serial clock  (6.25 MHz = 25 MHz / (2 x CLKS_PER_HALF_BIT=4))
//    w_SPI_MOSI  : Master-Out Slave-In data line (MSB first)
//    w_SPI_CS_n  : Active-low Chip-Select; LOW during a burst, HIGH between
//    i_SPI_MISO  : Master-In Slave-Out (looped back to w_SPI_MOSI in TB)
//
//  [RX Results - data received back by the master]
//    w_Master_RX_Byte  : 8-bit byte captured from MISO
//    w_Master_RX_DV    : 1-clock pulse when a complete byte has been received
//    w_Master_RX_Count : Count of bytes received in current CS window
//
//  [Internal DUT signals - SPI_Master_With_Single_CS state machine]
//    UUT.r_SM_CS            : CS state machine  00=IDLE  01=TRANSFER  10=CS_INACTIVE
//    UUT.r_CS_n             : Internal CS register (same as o_SPI_CS_n)
//    UUT.r_TX_Count         : Remaining bytes to transmit in this CS window
//    UUT.r_CS_Inactive_Count: Down-counter for CS high gap between transfers
//    UUT.w_Master_Ready     : Core SPI_Master ready signal (wired internally)
//
//  [Internal DUT signals - SPI_Master core]
//    UUT.SPI_Master_Inst.r_SPI_Clk_Edges : How many SPI clock edges remain (0-16)
//    UUT.SPI_Master_Inst.r_TX_Bit_Count  : Which bit is being shifted out (7 down to 0)
//    UUT.SPI_Master_Inst.r_RX_Bit_Count  : Which bit is being shifted in
//    UUT.SPI_Master_Inst.r_Leading_Edge  : Leading-edge strobe (1 clock wide)
//    UUT.SPI_Master_Inst.r_Trailing_Edge : Trailing-edge strobe (1 clock wide)
//    UUT.SPI_Master_Inst.r_TX_Byte       : Registered copy of byte being sent
// =============================================================================

// ── Open a new waveform window ─────────────────────────────────────────────
wvCreateWindow

// ── Set time display to nanoseconds ───────────────────────────────────────
wvSetTimeUnit -timeunit ns

// ==========================================================================
// GROUP 1 : Clock & Reset
// ==========================================================================
wvAddGroup -label "Clock & Reset"

// System clock - 25 MHz, period 4 ns
wvAddSignal -label "r_Clk [sys 25MHz]" \
    SPI_Master_With_Single_CS_TB.r_Clk

// Active-low asynchronous reset
wvAddSignal -label "r_Rst_L [active-low]" \
    SPI_Master_With_Single_CS_TB.r_Rst_L

// ==========================================================================
// GROUP 2 : TX Control (host -> DUT)
// ==========================================================================
wvAddGroup -label "TX Control (host -> DUT)"

// Number of bytes to transfer per CS assertion (set to 2 in TB)
wvAddSignal -label "r_Master_TX_Count [bytes/CS]" \
    SPI_Master_With_Single_CS_TB.r_Master_TX_Count

// Byte to transmit - should show 0xC1 then 0xC2
wvAddSignal -radix hex -label "r_Master_TX_Byte [8b TX data]" \
    SPI_Master_With_Single_CS_TB.r_Master_TX_Byte

// Data-valid trigger pulse: 1 clock wide
wvAddSignal -label "r_Master_TX_DV [TX trigger]" \
    SPI_Master_With_Single_CS_TB.r_Master_TX_DV

// Ready flag: HIGH when master can accept next byte
wvAddSignal -label "w_Master_TX_Ready [DUT ready]" \
    SPI_Master_With_Single_CS_TB.w_Master_TX_Ready

// ==========================================================================
// GROUP 3 : SPI Bus (4-wire physical interface)
// ==========================================================================
wvAddGroup -label "SPI Bus (4-wire)"

// SPI chip-select - active LOW during a transfer window
wvAddSignal -label "w_SPI_CS_n [CS - active LOW]" \
    SPI_Master_With_Single_CS_TB.w_SPI_CS_n

// SPI serial clock generated by the master
wvAddSignal -label "w_SPI_Clk [6.25 MHz]" \
    SPI_Master_With_Single_CS_TB.w_SPI_Clk

// MOSI data line - observe bit-serial data (MSB first)
wvAddSignal -label "w_SPI_MOSI [MOSI data]" \
    SPI_Master_With_Single_CS_TB.w_SPI_MOSI

// MISO line - looped back to MOSI in TB (full-duplex loopback)
// RX byte should match TX byte exactly in this loopback configuration
wvAddSignal -label "i_SPI_MISO [MISO loopback]" \
    SPI_Master_With_Single_CS_TB.UUT.i_SPI_MISO

// ==========================================================================
// GROUP 4 : RX Results (DUT -> host)
// ==========================================================================
wvAddGroup -label "RX Results (DUT -> host)"

// Index of the byte just received (0, 1, ...)
wvAddSignal -label "w_Master_RX_Count [RX byte index]" \
    SPI_Master_With_Single_CS_TB.w_Master_RX_Count

// RX data-valid: 1-clock pulse after a complete byte is received
wvAddSignal -label "w_Master_RX_DV [RX valid pulse]" \
    SPI_Master_With_Single_CS_TB.w_Master_RX_DV

// Byte received on MISO - should match TX byte (loopback)
wvAddSignal -radix hex -label "w_Master_RX_Byte [8b RX data]" \
    SPI_Master_With_Single_CS_TB.w_Master_RX_Byte

// ==========================================================================
// GROUP 5 : DUT Internal - CS State Machine  (SPI_Master_With_Single_CS)
// ==========================================================================
wvAddGroup -label "DUT Internal: CS State Machine"

// CS control state machine: 00=IDLE, 01=TRANSFER, 10=CS_INACTIVE
wvAddSignal -radix binary -label "UUT.r_SM_CS [00=IDLE 01=XFR 10=CSinact]" \
    SPI_Master_With_Single_CS_TB.UUT.r_SM_CS

// Internal CS register (feeds o_SPI_CS_n output)
wvAddSignal -label "UUT.r_CS_n [internal CS reg]" \
    SPI_Master_With_Single_CS_TB.UUT.r_CS_n

// Down-counter: how many more bytes remain in this CS window
wvAddSignal -label "UUT.r_TX_Count [bytes remaining]" \
    SPI_Master_With_Single_CS_TB.UUT.r_TX_Count

// CS inactive period counter (10 clocks between transfers)
wvAddSignal -label "UUT.r_CS_Inactive_Count [CS gap timer]" \
    SPI_Master_With_Single_CS_TB.UUT.r_CS_Inactive_Count

// Core SPI_Master ready output (wire inside wrapper)
wvAddSignal -label "UUT.w_Master_Ready [core ready]" \
    SPI_Master_With_Single_CS_TB.UUT.w_Master_Ready

// ==========================================================================
// GROUP 6 : DUT Internal - SPI_Master Core
// ==========================================================================
wvAddGroup -label "DUT Internal: SPI_Master Core"

// Registered TX byte held by the core
wvAddSignal -radix hex -label "SPI_Master.r_TX_Byte [latched TX]" \
    SPI_Master_With_Single_CS_TB.UUT.SPI_Master_Inst.r_TX_Byte

// SPI clock edge counter (starts at 16, counts down to 0 per byte)
wvAddSignal -label "SPI_Master.r_SPI_Clk_Edges [clk edges remaining]" \
    SPI_Master_With_Single_CS_TB.UUT.SPI_Master_Inst.r_SPI_Clk_Edges

// Current TX bit position (7 -> 0, MSB first)
wvAddSignal -label "SPI_Master.r_TX_Bit_Count [TX bit index 7..0]" \
    SPI_Master_With_Single_CS_TB.UUT.SPI_Master_Inst.r_TX_Bit_Count

// Current RX bit position (7 -> 0)
wvAddSignal -label "SPI_Master.r_RX_Bit_Count [RX bit index 7..0]" \
    SPI_Master_With_Single_CS_TB.UUT.SPI_Master_Inst.r_RX_Bit_Count

// Leading-edge strobe (1 clock wide, used to latch MISO / drive MOSI)
wvAddSignal -label "SPI_Master.r_Leading_Edge [clk leading strobe]" \
    SPI_Master_With_Single_CS_TB.UUT.SPI_Master_Inst.r_Leading_Edge

// Trailing-edge strobe (1 clock wide)
wvAddSignal -label "SPI_Master.r_Trailing_Edge [clk trailing strobe]" \
    SPI_Master_With_Single_CS_TB.UUT.SPI_Master_Inst.r_Trailing_Edge

// Internal SPI clock register (1-cycle ahead of o_SPI_Clk output)
wvAddSignal -label "SPI_Master.r_SPI_Clk [internal SPI clk reg]" \
    SPI_Master_With_Single_CS_TB.UUT.SPI_Master_Inst.r_SPI_Clk

// ==========================================================================
// Display settings
// ==========================================================================

// Fit all waveforms to the window width
wvZoomFitAll

// Show signal values at cursor
wvSetCursorMode -time 0

// End of spi_signals.rc
